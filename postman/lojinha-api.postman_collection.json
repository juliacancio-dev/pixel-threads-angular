    {
      "name": "2. Clientes - POST (2 inserções)",
      "item": [
        {
          "name": "POST Cliente 01 - Ana Souza",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A API responde 'Cliente gravado com sucesso! <codigo>': guarda o código para o PUT",
                  "const m = pm.response.text().match(/(\\d+)\\s*$/);",
                  "if (m) pm.collectionVariables.set('clienteCodigo', m[1]);",
                  "pm.test('Cliente gravado', () => pm.expect(pm.response.text()).to.include('gravado com sucesso'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/cliente",
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Ana Souza\",\n  \"telefone\": \"(11) 98888-1111\",\n  \"documento\": \"12345678900\",\n  \"senha\": \"123456\",\n  \"logradouro\": \"Rua das Flores, 100 - São Paulo/SP\",\n  \"email\": \"ana.souza@email.com\",\n  \"ativo\": 1\n}" }
          }
        },
        {
          "name": "POST Cliente 02 - Bruno Lima",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/cliente",
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Bruno Lima\",\n  \"telefone\": \"(21) 97777-2222\",\n  \"documento\": \"98765432100\",\n  \"senha\": \"abc123\",\n  \"logradouro\": \"Av. Atlântica, 500 - Rio de Janeiro/RJ\",\n  \"email\": \"bruno.lima@email.com\",\n  \"ativo\": 1\n}" }
          }
        }
      ]
    },
    {
      "name": "3. Cliente - PUT (alteração)",
      "item": [
        {
          "name": "PUT Cliente - altera Ana Souza",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cliente alterado', () => pm.expect(pm.response.text()).to.include('alterado com sucesso'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/cliente",
            "description": "O PUT faz save() do objeto inteiro: envie TODOS os campos, senão os omitidos ficam nulos. O código vem do POST do Cliente 01 (variável clienteCodigo).",
            "body": { "mode": "raw", "raw": "{\n  \"codigo\": {{clienteCodigo}},\n  \"nome\": \"Ana Souza Martins\",\n  \"telefone\": \"(11) 95555-3333\",\n  \"documento\": \"12345678900\",\n  \"senha\": \"123456\",\n  \"logradouro\": \"Rua Nova, 250 - Campinas/SP\",\n  \"email\": \"ana.martins@email.com\",\n  \"ativo\": 1\n}" }
          }
        },
        {
          "name": "GET Cliente - confere alteração",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/cliente/{{clienteCodigo}}"
          }
        }
      ]
    },
    {
      "name": "4. Produtos - GET (consulta)",
      "item": [
        {
          "name": "GET Listar todos os produtos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Retorna pelo menos 10 produtos', () => pm.expect(pm.response.json().length).to.be.at.least(10));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/produtos"
          }
        },
        {
          "name": "GET Produto por código (1)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/produto/1"
          }
        },
        {
          "name": "GET Vitrine (destaque > 0)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/produto/vitrine"
          }
        }
      ]
